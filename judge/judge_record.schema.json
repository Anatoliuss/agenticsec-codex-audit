{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "judge_record.schema.json",
  "title": "LLM-as-a-judge record",
  "description": "One judge evaluation of one run, storing the judge's verdict AND its reasoning, linked to the sample, the run, and the ground-truth vulnerability it adjudicates.",
  "type": "object",
  "required": [
    "judge_id", "run_id", "sample_id", "configuration",
    "judge_model", "judged_at", "per_vuln", "overall"
  ],
  "properties": {
    "judge_id": {"type": "string"},
    "run_id": {"type": "string", "description": "FK -> run_record.run_id"},
    "sample_id": {"type": "string", "description": "FK -> sample.sample_id"},
    "configuration": {"type": "string", "enum": ["zero_shot", "cve_hinted"]},
    "judge_model": {"type": "string"},
    "judge_mode": {"type": "string", "enum": ["llm", "deterministic"], "description": "deterministic = offline rule-based fallback over the matcher."},
    "judged_at": {"type": "string", "format": "date-time"},
    "ground_truth_ref": {"type": "string", "description": "path to the ground_truth.json adjudicated against."},
    "per_vuln": {
      "type": "array",
      "description": "one entry per ground-truth vulnerability.",
      "items": {
        "type": "object",
        "required": ["vuln_id", "cve", "vulnerable_function", "verdict", "reasoning"],
        "properties": {
          "vuln_id": {"type": "string"},
          "cve": {"type": "string"},
          "vulnerable_function": {"type": "string"},
          "verdict": {"type": "string", "enum": ["identified", "partially_identified", "missed"]},
          "located_function": {"type": "boolean", "description": "deterministic matcher result for this vuln."},
          "match_type": {"type": "string", "enum": ["exact", "alias", "file_line", "none"]},
          "matching_finding_id": {"type": ["string", "null"]},
          "explanation_quality": {"type": "string", "enum": ["correct", "plausible", "insufficient_evidence", "incorrect", "n/a"]},
          "reasoning": {"type": "string", "description": "the judge's justification for this verdict — stored verbatim."}
        }
      }
    },
    "other_findings": {
      "type": "array",
      "description": "findings not matching any ground-truth vuln; each gets a judge note and a manual-validation flag.",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {"type": ["string", "null"]},
          "vulnerable_function": {"type": ["string", "null"]},
          "file": {"type": ["string", "null"]},
          "judge_label": {"type": "string", "enum": ["likely_false_positive", "possible_true_positive_unknown", "out_of_scope", "unclear"]},
          "reasoning": {"type": "string"},
          "flag": {"type": "string", "enum": ["manual_validation_required"]}
        }
      }
    },
    "overall": {
      "type": "object",
      "required": ["located_count", "total_vulns"],
      "properties": {
        "located_count": {"type": "integer"},
        "total_vulns": {"type": "integer"},
        "run_status": {"type": "string"},
        "summary_reasoning": {"type": "string"}
      }
    }
  }
}
