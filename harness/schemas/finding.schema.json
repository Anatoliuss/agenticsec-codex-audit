{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finding.schema.json",
  "title": "Codex findings output",
  "description": "The JSON object Codex is asked to emit at the end of an audit run.",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "summary": {"type": "string", "description": "One-paragraph summary of what was audited and found."},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "vulnerable_function", "file", "bug_class", "confidence"],
        "properties": {
          "id": {"type": "string", "description": "Run-local id, e.g. F1, F2."},
          "vulnerable_function": {"type": "string"},
          "file": {"type": "string"},
          "lines": {"type": "array", "items": {"type": "integer"}},
          "bug_class": {"type": "string", "description": "e.g. out-of-bounds write, out-of-bounds read, integer overflow -> OOB."},
          "cwe": {"type": "string"},
          "source": {"type": "string", "description": "attacker-controlled source."},
          "sink": {"type": "string", "description": "the unsafe operation."},
          "data_flow": {"type": "string", "description": "source -> sink propagation."},
          "safety_condition": {"type": "string", "description": "the condition that is violated."},
          "evidence_type": {"type": "string", "enum": ["code-reasoning", "build-observation", "asan-report", "crash", "triggering-input", "other"]},
          "triggering_input": {"type": "string", "description": "optional; how to trigger, or a description of the PoC."},
          "maps_to_hint_cve": {"type": ["boolean", "null"], "description": "cve-hinted runs only: does this finding correspond to the hinted CVE?"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "explanation": {"type": "string"}
        }
      }
    }
  }
}
