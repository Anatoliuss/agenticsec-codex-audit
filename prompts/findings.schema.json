      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vulnerable_function", "file", "lines", "bug_class", "cwe",
                     "source", "sink", "data_flow", "safety_condition", "evidence",
                     "evidence_type", "confidence", "maps_to_hinted_cve"],
        "properties": {
          "id": {"type": "string"},
          "vulnerable_function": {"type": "string"},
          "file": {"type": "string"},
          "lines": {"type": "array", "items": {"type": "integer"}},
          "bug_class": {"type": "string"},
          "cwe": {"type": "string"},
          "source": {"type": "string"},
          "sink": {"type": "string"},
          "data_flow": {"type": "string"},
          "safety_condition": {"type": "string"},
          "evidence": {"type": "string"},
          "evidence_type": {"type": "string", "enum": ["code-reasoning", "build-observation", "asan-report", "crash", "triggering-input", "other"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "maps_to_hinted_cve": {"type": ["boolean", "null"]}
