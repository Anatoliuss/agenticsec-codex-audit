{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ground_truth.schema.json",
  "title": "Ground-truth annotations for a benchmark sample",
  "type": "object",
  "required": ["sample_id", "project", "commit", "binary", "vulnerabilities"],
  "properties": {
    "sample_id": {"type": "string"},
    "project": {"type": "string"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "binary": {"type": "string"},
    "vulnerabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vuln_id", "cve", "bug_class", "vulnerable_function", "file", "evidence"],
        "properties": {
          "vuln_id": {"type": "string"},
          "cve": {"type": "string"},
          "cve_primary": {"type": "string"},
          "bug_class": {"type": "string"},
          "cwe": {"type": "string"},
          "cwe_secondary": {"type": "string"},
          "cwe_family": {"type": "string"},
          "vulnerable_function": {"type": "string"},
          "file": {"type": "string"},
          "function_decl_line": {"type": ["integer", "null"]},
          "alloc_line": {"type": ["integer", "null"]},
          "sink_hint_line": {"type": ["integer", "null"]},
          "sink_hint_lines": {"type": "array", "items": {"type": "integer"}},
          "sink_description": {"type": "string"},
          "trigger_path": {"type": "array", "items": {"type": "string"}},
          "severity_cvss_v3": {"type": ["number", "null"]},
          "match_aliases": {"type": "array", "items": {"type": "string"}},
          "fix_commits": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "needs_confirmation": {"type": "boolean"},
          "evidence": {"type": "object"},
          "alternatives": {"type": "array"}
        }
      }
    }
  }
}
